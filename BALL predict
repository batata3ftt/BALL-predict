-- BALL ESP ULTRA - Mais claro e destacado
-- LocalScript | Roblox Studio

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

-- CONFIGURAÇÕES
local BALL_NAME = "Ball"

-- Visual
local FILL_COLOR = Color3.fromRGB(255,255,255) -- branco puro
local FILL_TRANSPARENCY = 0.15                 -- quase sólido
local OUTLINE_COLOR = Color3.fromRGB(0,0,0)    -- preto
local OUTLINE_TRANSPARENCY = 0                 -- borda forte
local GLOW_COLOR = Color3.fromRGB(255,255,255) -- brilho branco
local GLOW_TRANSPARENCY = 0.3

local highlight
local highlightGlow

-- Criar ESP
local function createESP(ball)
    if highlight then highlight:Destroy() end
    if highlightGlow then highlightGlow:Destroy() end

    -- ESP principal
    highlight = Instance.new("Highlight")
    highlight.Name = "BallESP"
    highlight.Adornee = ball
    highlight.FillColor = FILL_COLOR
    highlight.FillTransparency = FILL_TRANSPARENCY
    highlight.OutlineColor = OUTLINE_COLOR
    highlight.OutlineTransparency = OUTLINE_TRANSPARENCY
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = ball

    -- Glow extra (segunda camada)
    highlightGlow = Instance.new("Highlight")
    highlightGlow.Name = "BallGlow"
    highlightGlow.Adornee = ball
    highlightGlow.FillColor = GLOW_COLOR
    highlightGlow.FillTransparency = GLOW_TRANSPARENCY
    highlightGlow.OutlineTransparency = 1
    highlightGlow.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlightGlow.Parent = ball
end

-- Procurar bola
local function findBall()
    local ball = workspace:FindFirstChild(BALL_NAME)
    if ball then
        createESP(ball)
    end
end

-- Caso a bola reapareça
workspace.ChildAdded:Connect(function(child)
    if child.Name == BALL_NAME then
        task.wait(0.1)
        createESP(child)
    end
end)

findBall()

print("⚪⚫ Ball ESP ULTRA ativo")
